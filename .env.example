# Get keys from https://aistudio.google.com/apikey
# Never commit real API keys.
GEMINI_API_KEY=replace-with-your-primary-gemini-api-key
GEMINI_API_KEY_BACKUP=replace-with-your-backup-gemini-api-key
PORT=3000
# Optional: override the default model used by server.js
# GEMINI_MODEL=gemini-4-hydrogen
# Optional: shared daily request cap (default 200)
# GEMINI_DAILY_LIMIT=200
